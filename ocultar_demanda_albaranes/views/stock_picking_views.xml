<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar la vista de formulario de stock.picking para hacer la columna Demanda opcional -->
    <record id="view_picking_form_inherit_demanda_opcional" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.demanda.opcional</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Modificar el campo product_uom_qty (Demanda) para hacerlo opcional -->
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_uom_qty']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
