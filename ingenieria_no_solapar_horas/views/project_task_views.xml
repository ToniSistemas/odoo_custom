<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_timesheet_slots" model="ir.ui.view">
        <field name="name">project.task.form.timesheet.slots</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='timesheet_ids']/list/field[@name='employee_id']" position="after">
                <field name="start_slot" required="1" readonly="readonly_timesheet"/>
                <field name="end_slot" required="1" readonly="readonly_timesheet"/>
                <field name="occupied_intervals" readonly="1" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/form//field[@name='employee_id']" position="after">
                <field name="start_slot" required="1" readonly="readonly_timesheet"/>
                <field name="end_slot" required="1" readonly="readonly_timesheet"/>
                <field name="occupied_intervals" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/list/field[@name='unit_amount']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/form//field[@name='unit_amount']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>