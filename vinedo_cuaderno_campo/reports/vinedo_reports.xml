<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_cuaderno_campo" model="ir.actions.report">
        <field name="name">Cuaderno de Campo</field>
        <field name="model">vinedo.finca</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vinedo_cuaderno_campo.report_cuaderno_campo</field>
        <field name="report_file">vinedo_cuaderno_campo.report_cuaderno_campo</field>
        <field name="binding_model_id" ref="model_vinedo_finca"/>
        <field name="binding_view_types">form</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <record id="report_cuaderno_campo_template" model="ir.ui.view">
        <field name="name">vinedo.finca.report_cuaderno_campo</field>
        <field name="type">qweb</field>
        <field name="key">vinedo_cuaderno_campo.report_cuaderno_campo</field>
        <field name="arch" type="xml">
            <t t-name="vinedo_cuaderno_campo.report_cuaderno_campo">
                <t t-call="web.external_layout">
                    <t t-set="finca" t-value="doc"/>
                    <t t-set="anio" t-value="context_today().year"/>
                    <div class="page">
                        <!-- Título -->
                        <h2 style="text-align:center; margin-bottom:20px;">
                            Cuaderno de Campo — <t t-esc="finca.name"/>
                            <br/>
                            <small>Año <t t-esc="anio"/></small>
                        </h2>

                        <!-- Datos de la finca -->
                        <h3>Datos de la Finca</h3>
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Nombre:</strong></td>
                                <td t-esc="finca.name"/>
                                <td><strong>Territorio:</strong></td>
                                <td t-esc="finca.territory_id.name or ''"/>
                            </tr>
                            <tr>
                                <td><strong>Extensión (ha):</strong></td>
                                <td t-esc="finca.area"/>
                                <td><strong>Ref. SIGPAC:</strong></td>
                                <td t-esc="finca.ref_sigpac or ''"/>
                            </tr>
                            <tr>
                                <td><strong>Latitud:</strong></td>
                                <td t-esc="finca.latitude or ''"/>
                                <td><strong>Longitud:</strong></td>
                                <td t-esc="finca.longitude or ''"/>
                            </tr>
                        </table>

                        <!-- Variedades plantadas -->
                        <h3>Variedades Plantadas</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Variedad</th>
                                    <th>Superficie (ha)</th>
                                    <th>Superficie (m²)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="finca.variedad_ids" t-as="v">
                                    <tr>
                                        <td t-esc="v.variedad_id.name"/>
                                        <td t-esc="v.superficie"/>
                                        <td t-esc="v.superficie_m2"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Registro meteorológico -->
                        <h3>Registro Meteorológico</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>T. Máx (°C)</th>
                                    <th>T. Mín (°C)</th>
                                    <th>T. Media (°C)</th>
                                    <th>Precip. (mm)</th>
                                    <th>Humedad (%)</th>
                                    <th>Riesgo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="climas" t-value="finca.env['vinedo.registro.clima'].search([('finca_id','=',finca.id),('fecha','&gt;=',str(anio)+'-01-01'),('fecha','&lt;=',str(anio)+'-12-31')], order='fecha desc')"/>
                                <t t-foreach="climas" t-as="cl">
                                    <tr>
                                        <td t-esc="cl.fecha"/>
                                        <td t-esc="cl.temperatura_max or ''"/>
                                        <td t-esc="cl.temperatura_min or ''"/>
                                        <td t-esc="cl.temperatura_media or ''"/>
                                        <td t-esc="cl.precipitacion or ''"/>
                                        <td t-esc="cl.humedad_relativa or ''"/>
                                        <td t-esc="dict(cl._fields['riesgo'].selection).get(cl.riesgo,'')"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Seguimiento fenológico -->
                        <h3>Seguimiento Fenológico (BBCH)</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Código BBCH</th>
                                    <th>Descripción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="fenos" t-value="finca.env['vinedo.seguimiento.fenologico'].search([('finca_id','=',finca.id),('fecha','&gt;=',str(anio)+'-01-01'),('fecha','&lt;=',str(anio)+'-12-31')], order='fecha desc')"/>
                                <t t-foreach="fenos" t-as="fen">
                                    <tr>
                                        <td t-esc="fen.fecha"/>
                                        <td t-esc="fen.codigo_bbch"/>
                                        <td t-esc="fen.descripcion"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Tratamientos -->
                        <h3>Tratamientos Fitosanitarios</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Producto</th>
                                    <th>Litros</th>
                                    <th>Coste (€)</th>
                                    <th>Materia Activa</th>
                                    <th>PHI (días)</th>
                                    <th>Cosecha no antes de</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="trats" t-value="finca.env['vinedo.tratamiento'].search([('finca_id','=',finca.id),('fecha','&gt;=',str(anio)+'-01-01'),('fecha','&lt;=',str(anio)+'-12-31')], order='fecha desc')"/>
                                <t t-foreach="trats" t-as="trat">
                                    <tr>
                                        <td t-esc="trat.fecha"/>
                                        <td t-esc="trat.producto or trat.producto_id.name or ''"/>
                                        <td t-esc="trat.litros or ''"/>
                                        <td t-esc="trat.coste or ''"/>
                                        <td t-esc="trat.materia_activa_info or ''"/>
                                        <td t-esc="trat.phi_info or ''"/>
                                        <td t-esc="trat.phi_vencimiento or ''"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Aportaciones -->
                        <h3>Aportaciones de Minerales/Abonos</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Producto</th>
                                    <th>Cantidad (kg)</th>
                                    <th>Coste (€)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="aports" t-value="finca.env['vinedo.aportacion'].search([('finca_id','=',finca.id),('fecha','&gt;=',str(anio)+'-01-01'),('fecha','&lt;=',str(anio)+'-12-31')], order='fecha desc')"/>
                                <t t-foreach="aports" t-as="ap">
                                    <tr>
                                        <td t-esc="ap.fecha"/>
                                        <td t-esc="ap.producto_id.name"/>
                                        <td t-esc="ap.cantidad or ''"/>
                                        <td t-esc="ap.coste or ''"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Trabajos -->
                        <h3>Trabajos</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Trabajo</th>
                                    <th>Empleado</th>
                                    <th>Horas</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="trabajos" t-value="finca.env['vinedo.trabajo'].search([('finca_id','=',finca.id),('fecha','&gt;=',str(anio)+'-01-01'),('fecha','&lt;=',str(anio)+'-12-31')], order='fecha desc')"/>
                                <t t-foreach="trabajos" t-as="trb">
                                    <tr>
                                        <td t-esc="trb.fecha"/>
                                        <td t-esc="trb.tipo_trabajo.name"/>
                                        <td t-esc="trb.empleado_id.name or ''"/>
                                        <td t-esc="trb.horas or ''"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Podas -->
                        <h3>Podas</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Tipo de poda</th>
                                    <th>Empleado</th>
                                    <th>Descripción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="podas" t-value="finca.env['vinedo.poda'].search([('finca_id','=',finca.id),('fecha','&gt;=',str(anio)+'-01-01'),('fecha','&lt;=',str(anio)+'-12-31')], order='fecha desc')"/>
                                <t t-foreach="podas" t-as="pod">
                                    <tr>
                                        <td t-esc="pod.fecha"/>
                                        <td t-esc="dict(pod._fields['tipo_poda'].selection).get(pod.tipo_poda,'') if pod.tipo_poda else ''"/>
                                        <td t-esc="pod.empleado_id.name or ''"/>
                                        <td t-esc="pod.descripcion or ''"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Añadas -->
                        <h3>Añadas / Cosechas</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Año</th>
                                    <th>Variedad</th>
                                    <th>Kg</th>
                                    <th>% vol</th>
                                    <th>pH</th>
                                    <th>Acidez (g/L)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="finca.anada_ids.filtered(lambda a: a.anio == anio)" t-as="an">
                                    <tr>
                                        <td t-esc="an.anio"/>
                                        <td t-esc="an.variedad_id.name"/>
                                        <td t-esc="an.cantidad or ''"/>
                                        <td t-esc="an.graduacion or ''"/>
                                        <td t-esc="an.ph or ''"/>
                                        <td t-esc="an.acidez_total or ''"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Lotes de cosecha -->
                        <h3>Lotes de Cosecha</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Lote</th>
                                    <th>Fecha</th>
                                    <th>Variedad</th>
                                    <th>Cantidad (kg)</th>
                                    <th>Destino</th>
                                    <th>Bodega / Comprador</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lotes" t-value="finca.env['vinedo.lote.cosecha'].search([('finca_id','=',finca.id),('anio','=',anio)], order='fecha_creacion desc')"/>
                                <t t-foreach="lotes" t-as="lot">
                                    <tr>
                                        <td t-esc="lot.name"/>
                                        <td t-esc="lot.fecha_creacion"/>
                                        <td t-esc="lot.variedad_id.name or ''"/>
                                        <td t-esc="lot.cantidad_kg or ''"/>
                                        <td t-esc="dict(lot._fields['destino'].selection).get(lot.destino,'')"/>
                                        <td t-esc="lot.bodega_destino or ''"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Indicadores de gestión -->
                        <t t-set="coste_trat" t-value="sum(tr.coste for tr in trats if tr.coste) or 0.0"/>
                        <t t-set="coste_aport" t-value="sum(ap.coste for ap in aports if ap.coste) or 0.0"/>
                        <t t-set="horas_total" t-value="sum(trb.horas for trb in trabajos if trb.horas) or 0.0"/>
                        <t t-set="kg_total" t-value="sum(lot.cantidad_kg for lot in lotes if lot.cantidad_kg) or 0.0"/>

                        <h3>Resumen del Año</h3>
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Coste tratamientos (€):</strong></td>
                                <td t-esc="'%.2f' % coste_trat"/>
                                <td><strong>Coste aportaciones (€):</strong></td>
                                <td t-esc="'%.2f' % coste_aport"/>
                            </tr>
                            <tr>
                                <td><strong>Horas trabajadas:</strong></td>
                                <td t-esc="'%.2f' % horas_total"/>
                                <td><strong>Kg cosechados:</strong></td>
                                <td t-esc="'%.2f' % kg_total"/>
                            </tr>
                        </table>

                        <p style="text-align:center; margin-top:40px; color:#999; font-size:11px;">
                            Generado el <t t-esc="context_today()"/> —
                            Cuaderno de Campo Digital · vinedo_cuaderno_campo
                        </p>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
