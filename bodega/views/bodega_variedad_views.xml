<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Variedad de Uva                                              -->
    <!-- ============================================================ -->
    <record id="view_bodega_variedad_list" model="ir.ui.view">
        <field name="name">bodega.variedad.list</field>
        <field name="model">bodega.variedad</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tipo"/>
                <field name="descripcion"/>
            </list>
        </field>
    </record>

    <record id="view_bodega_variedad_form" model="ir.ui.view">
        <field name="name">bodega.variedad.form</field>
        <field name="model">bodega.variedad</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tipo"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="descripcion" placeholder="Descripción de la variedad..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bodega_variedad" model="ir.actions.act_window">
        <field name="name">Variedades de Uva</field>
        <field name="res_model">bodega.variedad</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
