<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_auto_image_log_view_list" model="ir.ui.view">
        <field name="name">product.auto.image.log.list</field>
        <field name="model">product.auto.image.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false"
                  decoration-success="status == 'found'"
                  decoration-info="status == 'simulated'"
                  decoration-warning="status in ('not_found', 'skipped')"
                  decoration-danger="status == 'error'">
                <field name="create_date" string="Fecha"/>
                <field name="product_id"/>
                <field name="manufacturer_brand" optional="show"/>
                <field name="manufacturer_reference" optional="show"/>
                <field name="ean" optional="hide"/>
                <field name="search_method"/>
                <field name="confidence"/>
                <field name="status"/>
                <field name="image_url" widget="image_url" options="{'size': [48, 48]}" string="Imagen" optional="show"/>
                <field name="source_url" widget="url" optional="show"/>
                <field name="error_message" optional="hide"/>
                <field name="create_uid" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="product_auto_image_log_view_form" model="ir.ui.view">
        <field name="name">product.auto.image.log.form</field>
        <field name="model">product.auto.image.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Producto">
                            <field name="product_id"/>
                            <field name="manufacturer_brand"/>
                            <field name="manufacturer_reference"/>
                            <field name="ean"/>
                            <field name="create_date" string="Fecha"/>
                            <field name="create_uid" string="Usuario"/>
                        </group>
                        <group string="Resultado">
                            <field name="status"/>
                            <field name="search_method"/>
                            <field name="confidence"/>
                            <field name="source_url" widget="url"/>
                            <field name="image_url" widget="url"/>
                        </group>
                    </group>
                    <group string="Imagen encontrada" invisible="not image_url">
                        <field name="image_url" widget="image_url" options="{'size': [300, 300]}" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Búsqueda">
                        <field name="search_query"/>
                        <field name="error_message" invisible="not error_message"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_auto_image_log_view_search" model="ir.ui.view">
        <field name="name">product.auto.image.log.search</field>
        <field name="model">product.auto.image.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="manufacturer_reference"/>
                <field name="manufacturer_brand"/>
                <field name="ean"/>
                <field name="source_url"/>
                <filter name="filter_found" string="Guardadas" domain="[('status', '=', 'found')]"/>
                <filter name="filter_simulated" string="Simulación" domain="[('status', '=', 'simulated')]"/>
                <filter name="filter_not_found" string="No encontradas" domain="[('status', '=', 'not_found')]"/>
                <filter name="filter_error" string="Errores" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter name="filter_method_ref" string="Por referencia" domain="[('search_method', '=', 'manufacturer_reference')]"/>
                <filter name="filter_method_ean" string="Por EAN" domain="[('search_method', '=', 'ean')]"/>
                <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>
                <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                <filter name="group_method" string="Método" context="{'group_by': 'search_method'}"/>
            </search>
        </field>
    </record>

    <record id="action_product_auto_image_log" model="ir.actions.act_window">
        <field name="name">Registro de imágenes automáticas</field>
        <field name="res_model">product.auto.image.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no se ha realizado ninguna búsqueda automática de imágenes.</p>
        </field>
    </record>

    <menuitem id="menu_product_auto_image_log_purchase"
              name="Registro de imágenes automáticas"
              parent="purchase.menu_purchase_products"
              action="action_product_auto_image_log"
              sequence="41"/>

    <menuitem id="menu_product_auto_image_log_pos"
              name="Registro de imágenes automáticas"
              parent="point_of_sale.menu_point_config_product"
              action="action_product_auto_image_log"
              sequence="41"/>
</odoo>
