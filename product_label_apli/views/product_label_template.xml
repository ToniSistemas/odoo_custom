<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_producttemplatelabel4x11_custom">
        <t t-call="web.basic_layout">
            <div class="page">
                <style>
                    .product_label { display: table-cell; height: 2.7cm; width: 4.85cm; page-break-inside: avoid; padding: 0.1cm; vertical-align: middle; text-align: center; }
                    .product_label strong { font-size: 0.9em; }
                    .product_label .price { font-size: 1.2em; font-weight: bold; }
                    .product_label .barcode { margin-top: 0.1cm; }
                </style>
                <t t-set="columns" t-value="4"/>
                <t t-set="rows" t-value="11"/>
                <t t-set="price_included" t-value="True"/>
                <t t-set="page_numbers" t-value="data.get('page_numbers', 1) if data else 1"/>
                <t t-set="product_ids" t-value="docs.ids if docs else (data.get('product_ids', []) if data else [])"/>
                <t t-set="all_products" t-value="env['product.product'].browse(product_ids)"/>
                
                <t t-foreach="range(0, page_numbers)" t-as="page">
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse;">
                        <t t-foreach="range(0, rows)" t-as="row">
                            <tr>
                                <t t-foreach="range(0, columns)" t-as="col">
                                    <t t-set="index" t-value="page * (rows * columns) + row * columns + col"/>
                                    <t t-if="index &lt; len(all_products)">
                                        <t t-set="product" t-value="all_products[index]"/>
                                        <td class="product_label">
                                            <strong t-field="product.display_name"/>
                                            <t t-if="price_included and product.list_price">
                                                <div class="price">
                                                    <t t-out="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                                </div>
                                            </t>
                                            <t t-if="product.barcode">
                                                <div class="barcode">
                                                    <t t-out="product.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 400, 'height': 80, 'humanreadable': 1}"/>
                                                </div>
                                            </t>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td class="product_label"/>
                                    </t>
                                </t>
                            </tr>
                        </t>
                    </table>
                    <p t-if="page &lt; page_numbers - 1" style="page-break-after: always;"/>
                </t>
            </div>
        </t>
    </template>
</odoo>
