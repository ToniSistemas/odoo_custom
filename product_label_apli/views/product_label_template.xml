<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_producttemplatelabel4x11_custom">
        <t t-call="web.basic_layout">
            <div class="page">
                <style>
                    .product_label { 
                        display: table-cell; 
                        height: 2.7cm; 
                        width: 4.85cm; 
                        page-break-inside: avoid; 
                        padding: 0.1cm; 
                        vertical-align: middle; 
                        text-align: center;
                        border: 1px solid #ddd;
                    }
                    .product_label .name { font-size: 0.85em; font-weight: bold; margin-bottom: 0.1cm; }
                    .product_label .price { font-size: 1.1em; font-weight: bold; margin: 0.1cm 0; }
                    .product_label .barcode { margin-top: 0.1cm; }
                    table { border-collapse: collapse; }
                </style>
                <t t-set="columns" t-value="4"/>
                <t t-set="rows" t-value="11"/>
                <t t-set="price_included" t-value="True"/>
                <t t-set="page_numbers" t-value="data.get('page_numbers', 1) if data else 1"/>
                <t t-set="product_ids" t-value="docs.ids if docs else (data.get('product_ids', []) if data else [])"/>
                <t t-set="all_products" t-value="env['product.product'].browse(product_ids)"/>
                
                <t t-foreach="range(0, page_numbers)" t-as="page_num">
                    <table style="width: 100%;">
                        <t t-foreach="range(0, rows)" t-as="row_num">
                            <tr>
                                <t t-foreach="range(0, columns)" t-as="col_num">
                                    <t t-set="idx" t-value="page_num * (rows * columns) + row_num * columns + col_num"/>
                                    <t t-if="idx &lt; len(all_products)">
                                        <t t-set="product" t-value="all_products[idx]"/>
                                        <td class="product_label">
                                            <div class="name">
                                                <span t-esc="product.display_name"/>
                                            </div>
                                            <t t-if="price_included and product.list_price">
                                                <div class="price">
                                                    <span t-esc="'%.2f €' % product.list_price"/>
                                                </div>
                                            </t>
                                            <t t-if="product.barcode">
                                                <div class="barcode">
                                                    <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=%s' % ('Code128', product.barcode, 400, 80, 1)" 
                                                         style="max-width: 100%; height: auto;"/>
                                                </div>
                                            </t>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td class="product_label"/>
                                    </t>
                                </t>
                            </tr>
                        </t>
                    </table>
                    <p t-if="page_num &lt; page_numbers - 1" style="page-break-after: always;"/>
                </t>
            </div>
        </t>
    </template>
</odoo>
