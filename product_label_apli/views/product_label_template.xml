<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_producttemplatelabel4x11_custom">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-set="columns" t-value="4"/>
                <t t-set="rows" t-value="11"/>
                <t t-set="price_included" t-value="True"/>
                <t t-set="page_numbers" t-value="data.get('page_numbers', 1) if data else 1"/>
                <t t-set="products" t-value="docs if docs else (env['product.product'].browse(data.get('product_ids', [])) if data else env['product.product'])"/>
                <t t-set="report_to_call" t-value="'4x12'"/>
                <t t-call="product.report_productlabel">
                    <t t-set="products" t-value="products"/>
                </t>
            </div>
        </t>
    </template>
</odoo>
