<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_silicie" model="ir.ui.view">
        <field name="name">stock.lot.form.silicie</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="bodega.view_production_lot_form_bodega"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='bodega']/group[1]" position="after">
                <group string="Impuestos Especiales / SILICIE">
                    <group>
                        <field name="silicie_codigo_nc_id" options="{'no_create': True}"/>
                        <field name="silicie_epigrafe_fiscal" readonly="1"/>
                    </group>
                    <group>
                        <field name="silicie_grado_alcoholico"/>
                        <field name="silicie_capacidad_envase"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>