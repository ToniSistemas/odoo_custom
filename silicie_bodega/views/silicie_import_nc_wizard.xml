<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_silicie_import_nc_wizard_form" model="ir.ui.view">
        <field name="name">silicie.import.nc.wizard.form</field>
        <field name="model">silicie.import.nc.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Códigos NC desde Internet">
                <group>
                    <field name="url" placeholder="https://ejemplo.org/codigos-nc.csv"/>
                    <field name="sobrescribir_descripcion"/>
                </group>
                <group string="Resultado" invisible="not num_creados and not num_actualizados">
                    <field name="num_creados" readonly="1"/>
                    <field name="num_actualizados" readonly="1"/>
                </group>
                <p class="text-muted">
                    El fichero debe incluir las columnas codigo y descripcion.
                    epigrafe_fiscal es opcional.
                </p>
                <footer>
                    <button name="action_importar" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>