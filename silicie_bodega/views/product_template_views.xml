<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_silicie_form" model="ir.ui.view">
        <field name="name">product.template.silicie.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Impuestos Especiales / SILICIE" name="silicie">
                    <group>
                        <group string="Clasificación fiscal">
                            <field name="silicie_codigo_nc_id" options="{'no_create': True}"/>
                            <field name="silicie_epigrafe_fiscal" readonly="1"/>
                        </group>
                        <group string="Características del producto">
                            <field name="silicie_grado_alcoholico"/>
                            <field name="silicie_capacidad_envase"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>