<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_picking_form_inherit_nota_albaran" model="ir.ui.view">
    <field name="name">stock.picking.form.inherit.nota.albaran</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group>
          <field name="sale_note"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_picking_tree_inherit_nota_albaran" model="ir.ui.view">
    <field name="name">stock.picking.tree.inherit.nota.albaran</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//tree" position="inside">
        <field name="sale_note"/>
      </xpath>
    </field>
  </record>
</odoo>
