<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_delivery_document_inherit" inherit_id="stock.report_delivery_document">
    <!-- Add VAT in delivery address section -->
    <xpath expr="//div[@name='outgoing_delivery_address']/div" position="after">
      <div t-if="o.partner_id.vat">
        <span t-field="o.partner_id.vat"/>
      </div>
    </xpath>
    
    <!-- Add note at the end of the page -->
    <xpath expr="//div[@name='signature']" position="before">
      <t t-if="o.sale_note_plain">
        <div class="row mt-4">
          <div class="col-12">
            <strong>Nota:</strong>
            <br/>
            <span t-esc="o.sale_note_plain"/>
          </div>
        </div>
      </t>
    </xpath>
  </template>
</odoo>
