<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_delivery_document_inherit" inherit_id="stock.report_delivery_document">
    <!-- Add VAT in delivery address section -->
    <xpath expr="//div[@name='outgoing_delivery_address']/div" position="after">
      <div t-if="o.partner_id.vat">
        <span t-field="o.partner_id.vat"/>
      </div>
    </xpath>
    
    <!-- Add note after tables -->
    <xpath expr="//table[@name='stock_move_line_table']" position="after">
      <t t-if="o.sale_note">
        <div class="row mt-4">
          <div class="col-12">
            <strong>Nota:</strong>
            <br/>
            <span t-field="o.sale_note" t-options="{'widget': 'text'}"/>
          </div>
        </div>
      </t>
    </xpath>
  </template>
</odoo>
