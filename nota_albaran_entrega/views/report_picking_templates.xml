<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Add customer VAT to delivery address -->
  <template id="report_picking_inherit_vat" inherit_id="stock.report_delivery_document">
    <xpath expr="//t[@t-set='information_block']/div[@t-field='o.partner_id']" position="after">
      <div t-if="o.partner_id.vat">
        <span t-field="o.partner_id.vat"/>
      </div>
    </xpath>
  </template>

  <!-- Add sale order note to the delivery slip PDF -->
  <template id="report_picking_inherit_sale_note" inherit_id="stock.report_delivery_document">
    <xpath expr="//t[@t-foreach='o.move_line_ids']" position="after">
      <t t-if="o.sale_note_plain">
        <tr>
          <td colspan="99">
            <br/>
            <strong>Nota:</strong>
            <br/>
            <span t-esc="o.sale_note_plain"/>
          </td>
        </tr>
      </t>
    </xpath>
  </template>
</odoo>
