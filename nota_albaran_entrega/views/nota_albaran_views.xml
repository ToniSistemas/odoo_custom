<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nota_albaran_tree" model="ir.ui.view">
    <field name="name">nota.albaran.tree</field>
    <field name="model">nota.albaran.entrega</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="delivery_date"/>
      </tree>
    </field>
  </record>

  <record id="view_nota_albaran_form" model="ir.ui.view">
    <field name="name">nota.albaran.form</field>
    <field name="model">nota.albaran.entrega</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="delivery_date"/>
            <field name="description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <menuitem id="menu_nota_albaran_root" name="Nota Albarán"/>
  <menuitem id="menu_nota_albaran" name="Entregas" parent="menu_nota_albaran_root"/>
  <record id="action_nota_albaran" model="ir.actions.act_window">
    <field name="name">Notas Albarán</field>
    <field name="res_model">nota.albaran.entrega</field>
    <field name="view_mode">tree,form</field>
  </record>
  <menuitem id="menu_nota_albaran_action" name="Ítems" parent="menu_nota_albaran" action="action_nota_albaran"/>
</odoo>
