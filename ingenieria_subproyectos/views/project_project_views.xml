<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         KANBAN NIVEL 1 — PROYECTOS PRINCIPALES
         Muestra proyectos con is_parent_project=True
         Cada tarjeta muestra nº de subproyectos y botón de acceso
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_parent_project_kanban" model="ir.ui.view">
        <field name="name">project.project.parent.kanban</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <kanban color="color">
                <field name="id"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="child_count"/>
                <field name="color"/>
                <field name="is_parent_project"/>
                <templates>
                    <t t-name="card">
                        <div class="p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong class="fs-6 text-truncate me-2">
                                    <field name="name"/>
                                </strong>
                                <field name="user_id"
                                       widget="many2one_avatar_user"
                                       readonly="1"/>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-3 text-muted">
                                <i class="fa fa-sitemap text-primary"/>
                                <span>
                                    <t t-esc="record.child_count.value"/>
                                    subproyecto(s)
                                </span>
                            </div>
                            <button name="action_view_subprojects"
                                    type="object"
                                    class="btn btn-primary btn-sm w-100">
                                <i class="fa fa-folder-open-o me-1"/>
                                Ver subproyectos
                            </button>
                        </div>
                    </t>
                    <t t-name="menu">
                        <a role="menuitem" type="edit" class="dropdown-item">Editar</a>
                        <a role="menuitem" type="delete" class="dropdown-item">Archivar</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         KANBAN NIVEL 2 — SUBPROYECTOS
         Se abre al pulsar "Ver subproyectos" en un proyecto principal
         Cada tarjeta muestra nº de tareas y botón para abrir el proyecto
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_subproject_kanban" model="ir.ui.view">
        <field name="name">project.project.subproject.kanban</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <kanban color="color">
                <field name="id"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="task_count"/>
                <field name="color"/>
                <field name="parent_id"/>
                <templates>
                    <t t-name="card">
                        <div class="p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong class="fs-6 text-truncate me-2">
                                    <field name="name"/>
                                </strong>
                                <field name="user_id"
                                       widget="many2one_avatar_user"
                                       readonly="1"/>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-1 text-muted">
                                <i class="fa fa-tasks text-success"/>
                                <span>
                                    <t t-esc="record.task_count.value"/>
                                    tarea(s)
                                </span>
                            </div>
                            <div class="text-muted small mb-3">
                                <i class="fa fa-sitemap me-1"/>
                                <field name="parent_id" readonly="1"/>
                            </div>
                            <button name="action_open_tasks"
                                    type="object"
                                    class="btn btn-success btn-sm w-100">
                                <i class="fa fa-list-ul me-1"/>
                                Abrir tareas
                            </button>
                        </div>
                    </t>
                    <t t-name="menu">
                        <a role="menuitem" type="edit" class="dropdown-item">Editar</a>
                        <a role="menuitem" type="delete" class="dropdown-item">Archivar</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         HERENCIA FORM — project.project
         Añade: smart button, tab "Jerarquía" con subproyectos
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_project_project_ingenieria_form" model="ir.ui.view">
        <field name="name">project.project.ingenieria.subproyectos.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <!-- Smart button: Subproyectos -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_subprojects"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sitemap"
                        invisible="not is_parent_project">
                    <field name="child_count" widget="statinfo" string="Subproyectos"/>
                </button>
            </xpath>

            <!-- Tab: Jerarquía de Proyecto -->
            <xpath expr="//notebook" position="inside">
                <page string="Jerarquía" name="project_hierarchy">
                    <group>
                        <group string="Configuración de jerarquía">
                            <field name="is_parent_project"/>
                            <field name="parent_id"
                                   invisible="is_parent_project"/>
                        </group>
                    </group>
                    <div invisible="not is_parent_project" class="mt-3">
                        <field name="child_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="user_id"
                                       widget="many2one_avatar_user"
                                       string="Responsable"/>
                                <field name="date_start" string="Inicio"/>
                                <field name="date" string="Fin"/>
                                <field name="task_count" string="Tareas"/>
                            </list>
                        </field>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         ACTION — Proyectos Principales
    ═══════════════════════════════════════════════════════════ -->
    <record id="action_parent_project" model="ir.actions.act_window">
        <field name="name">Proyectos Principales</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_parent_project_kanban"/>
        <field name="domain">[('is_parent_project', '=', True)]</field>
        <field name="context">{'default_is_parent_project': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer proyecto principal
            </p>
            <p>
                Los proyectos principales agrupan subproyectos relacionados.
                Activa "Es proyecto principal" en un proyecto existente o crea uno nuevo aquí.
            </p>
        </field>
    </record>

</odoo>
