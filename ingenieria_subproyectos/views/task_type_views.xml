<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_type_category_list" model="ir.ui.view">
        <field name="name">project.task.type.category.list</field>
        <field name="model">project.task.type.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_project_task_type_category_form" model="ir.ui.view">
        <field name="name">project.task.type.category.form</field>
        <field name="model">project.task.type.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_task_type_category" model="ir.actions.act_window">
        <field name="name">Tipos de tareas</field>
        <field name="res_model">project.task.type.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_project_task_type_category"
              name="Tipos de tareas"
              parent="project.menu_project_config"
              action="action_project_task_type_category"
              sequence="35"
              groups="project.group_project_manager"/>

    <record id="view_project_task_ingenieria_task_type_form" model="ir.ui.view">
        <field name="name">project.task.ingenieria.task.type.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="task_type_id" string="Tipo de tarea"/>
            </xpath>
        </field>
    </record>

    <record id="view_project_task_ingenieria_task_type_list" model="ir.ui.view">
        <field name="name">project.task.ingenieria.task.type.list</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="task_type_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>