<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_certificacion_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="cert">
            <t t-call="web.external_layout">
                <div class="page">

                    <!-- ── Título ────────────────────────────────── -->
                    <div class="row mb-4">
                        <div class="col-12 text-center">
                            <h2 style="margin-bottom:4px;">CERTIFICACIÓN DE OBRA</h2>
                            <h3 style="color:#666;"><t t-esc="cert.name"/></h3>
                        </div>
                    </div>

                    <!-- ── Cabecera: cliente / proyecto / período ── -->
                    <div class="row mb-3">
                        <div class="col-6">
                            <table class="table table-sm table-bordered">
                                <tr>
                                    <th class="bg-light" style="width:40%;">Cliente</th>
                                    <td><t t-esc="cert.partner_id.name"/></td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Proyecto</th>
                                    <td><t t-esc="cert.project_id.name"/></td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Contrato / Pedido</th>
                                    <td><t t-esc="cert.sale_order_id.name"/></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-6">
                            <table class="table table-sm table-bordered">
                                <tr>
                                    <th class="bg-light" style="width:45%;">Fecha certificación</th>
                                    <td><span t-field="cert.date"/></td>
                                </tr>
                                <tr t-if="cert.date_from">
                                    <th class="bg-light">Período desde</th>
                                    <td><span t-field="cert.date_from"/></td>
                                </tr>
                                <tr t-if="cert.date_to">
                                    <th class="bg-light">Período hasta</th>
                                    <td><span t-field="cert.date_to"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- ── Tabla de partidas ──────────────────────── -->
                    <table class="table table-sm table-bordered mt-3"
                           style="font-size:10px;">
                        <thead>
                            <tr class="bg-light">
                                <th style="width:26%;">Descripción</th>
                                <th class="text-center" style="width:6%;">Ud.</th>
                                <th class="text-right" style="width:8%;">Contrato</th>
                                <th class="text-right" style="width:8%;">Cert. Ant.</th>
                                <th class="text-right" style="width:8%;">Este período</th>
                                <th class="text-right" style="width:8%;">Total cert.</th>
                                <th class="text-right" style="width:7%;">% Av.</th>
                                <th class="text-right" style="width:7%;">Pendiente</th>
                                <th class="text-right" style="width:8%;">P. Unit.</th>
                                <th class="text-right" style="width:10%;">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="cert.line_ids" t-as="line">
                                <tr>
                                    <td><t t-esc="line.name"/></td>
                                    <td class="text-center">
                                        <t t-esc="line.uom_id.name"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'%.2f' % line.qty_contrato"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'%.2f' % line.qty_certificado_ant"/>
                                    </td>
                                    <td class="text-right">
                                        <strong><t t-esc="'%.2f' % line.qty_periodo"/></strong>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'%.2f' % line.qty_certificado_total"/>
                                    </td>
                                    <td class="text-right">
                                        <strong><t t-esc="'%.1f' % line.progress_pct + ' %'"/></strong>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'%.2f' % line.qty_pendiente"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'%.2f' % line.price_unit"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.amount"
                                              t-options='{"widget": "monetary", "display_currency": cert.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="8" class="text-right">
                                    TOTAL CONTRATO
                                </td>
                                <td class="text-right" colspan="2">
                                    <span t-field="cert.amount_contrato_total"
                                          t-options='{"widget": "monetary", "display_currency": cert.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6" class="text-right">
                                    <strong>TOTAL CERTIFICACIÓN</strong>
                                </td>
                                <td class="text-right">
                                    <strong><t t-esc="'%.1f' % cert.progress_pct + ' %'"/></strong>
                                </td>
                                <td class="text-right" colspan="3">
                                    <strong>
                                        <span t-field="cert.amount_total"
                                              t-options='{"widget": "monetary", "display_currency": cert.currency_id}'/>
                                    </strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- ── Notas ─────────────────────────────────── -->
                    <div t-if="cert.notes" class="mt-3">
                        <strong>Observaciones:</strong>
                        <p style="white-space:pre-wrap;"><t t-esc="cert.notes"/></p>
                    </div>

                    <!-- ── Firmas ─────────────────────────────────── -->
                    <div class="row mt-5 pt-4">
                        <div class="col-5 text-center offset-1">
                            <div style="border-top:1px solid #333; padding-top:6px;">
                                <strong>Por la empresa de ingeniería</strong>
                            </div>
                        </div>
                        <div class="col-5 text-center offset-1">
                            <div style="border-top:1px solid #333; padding-top:6px;">
                                <strong>Conforme el cliente</strong><br/>
                                <t t-esc="cert.partner_id.name"/>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
