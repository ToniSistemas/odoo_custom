<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_textile_quick_create" model="ir.ui.view">
        <field name="name">product.template.form.textile.quick.create</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attribute_line_ids']/list/field[@name='attribute_id']" position="attributes">
                <attribute name="widget">textile_attribute_quick_values</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_textile_auto_price" model="ir.ui.view">
        <field name="name">product.template.form.textile.auto.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="textile_auto_price" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
