<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vinedo_field_service.SimpleMapField">
        <div class="o_field_simple_map">
            <iframe t-att-src="mapUrl" 
                    style="width: 100%; height: 350px; border: 1px solid #ddd; border-radius: 4px;"
                    frameborder="0"
                    scrolling="no">
            </iframe>
            <div style="margin-top: 8px;">
                <a t-att-href="externalMapUrl" 
                   target="_blank" 
                   class="btn btn-sm btn-secondary">
                    <i class="fa fa-external-link"/> Ver en mapa completo
                </a>
            </div>
        </div>
    </t>
</templates>
