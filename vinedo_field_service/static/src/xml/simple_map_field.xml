<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vinedo_field_service.SimpleMapField">
        <div class="o_field_simple_map">
            <t t-if="this.hasCoordinates()">
                <iframe t-att-src="this.mapUrl" 
                        style="width: 100%; height: 350px; border: 1px solid #ddd; border-radius: 4px;"
                        frameborder="0"
                        scrolling="no">
                </iframe>
                <div style="margin-top: 8px;">
                    <a t-att-href="this.externalMapUrl" 
                       target="_blank" 
                       class="btn btn-sm btn-secondary">
                        <i class="fa fa-external-link"/> Ver en mapa completo
                    </a>
                </div>
            </t>
            <t t-else="">
                <div class="alert alert-info" style="margin: 10px 0;">
                    <h5><i class="fa fa-info-circle"/> ¿Cómo obtener coordenadas?</h5>
                    <p><strong>Método rápido:</strong></p>
                    <t t-if="this.hasFincaName()">
                        <a t-att-href="this.googleMapsSearchUrl" 
                           target="_blank" 
                           class="btn btn-primary btn-sm mb-2">
                            <i class="fa fa-map-marker"/> Buscar esta finca en Google Maps
                        </a>
                    </t>
                    <t t-else="">
                        <a href="https://www.google.com/maps" 
                           target="_blank" 
                           class="btn btn-primary btn-sm mb-2">
                            <i class="fa fa-map-marker"/> Abrir Google Maps
                        </a>
                    </t>
                    <p class="mt-3"><strong>Instrucciones:</strong></p>
                    <ol>
                        <li>Abre Google Maps y busca tu finca/parcela</li>
                        <li>Haz clic derecho en el punto exacto que quieres marcar</li>
                        <li>Copia las coordenadas que aparecen (ejemplo: 42.12345, -3.67890)</li>
                        <li>Ingresa los valores en los campos Latitud y Longitud arriba</li>
                        <li>Guarda el registro</li>
                    </ol>
                    <p class="text-muted"><small><strong>Nota:</strong> El mapa aparecerá automáticamente cuando guardes las coordenadas.</small></p>
                </div>
            </t>
        </div>
    </t>
</templates>
