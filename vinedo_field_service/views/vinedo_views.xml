<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Finca Views                                                  -->
    <!-- ============================================================ -->
    <record id="view_finca_tree" model="ir.ui.view">
        <field name="name">vinedo.finca.tree</field>
        <field name="model">vinedo.finca</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="territory_id"/>
                <field name="area" sum="Total Extensión (ha)"/>
            </list>
        </field>
    </record>

    <record id="view_finca_form" model="ir.ui.view">
        <field name="name">vinedo.finca.form</field>
        <field name="model">vinedo.finca</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="territory_id"/>
                            <field name="area"/>
                            <field name="area_m2" readonly="1"/>
                        </group>
                        <group>
                            <field name="latitude" string="Latitud"/>
                            <field name="longitude" string="Longitud"/>
                            <field name="ref_sigpac"/>
                            <field name="refs_sigpac_extra" readonly="1"
                                invisible="not refs_sigpac_extra"/>
                        </group>
                    </group>
                    <div style="margin:4px 0 12px 0;">
                        <button name="action_abrir_sigpac_visor" type="object"
                            string="Abrir en SIGPAC (nueva pestaña)" icon="fa-external-link"
                            class="btn btn-link" style="padding-left:0;"/>
                    </div>
                    <notebook>
                        <page string="Variedades">
                            <field name="variedad_ids">
                                <list editable="bottom">
                                    <field name="variedad_id"/>
                                    <field name="superficie" sum="Total (ha)" readonly="1"
                                           help="Calculado automáticamente desde los recintos"/>
                                    <field name="superficie_m2" readonly="1" sum="Total (m²)"/>
                                </list>
                            </field>
                        </page>
                        <page string="Variedades por recinto">
                            <field name="recinto_variedad_ids" readonly="1">
                                <list>
                                    <field name="recinto_id"/>
                                    <field name="variedad_id"/>
                                    <field name="porcentaje"/>
                                    <field name="superficie_ha" sum="Total (ha)"/>
                                    <field name="superficie_m2" sum="Total (m²)"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tratamientos">
                            <field name="tratamiento_ids">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="tipo"/>
                                    <field name="producto_id" invisible="tipo != 'fitosanitario'"
                                           options="{'no_quick_create': True}"/>
                                    <field name="producto" invisible="tipo == 'fitosanitario'"/>
                                    <field name="litros" optional="show"/>
                                    <field name="precio_litro" optional="hide"/>
                                    <field name="coste" optional="show" readonly="1"/>
                                    <field name="maquinaria_id" optional="show"/>
                                    <field name="fitosanitario_id" optional="show"/>
                                    <field name="materia_activa_info" optional="show" readonly="1"/>
                                    <field name="estado_registro_info" optional="hide" readonly="1"/>
                                    <field name="fecha_caducidad_reg" optional="hide" readonly="1"/>
                                    <field name="dosis" optional="hide"/>
                                    <field name="empleado_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Trabajos">
                            <field name="trabajo_ids">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="tipo_trabajo"/>
                                    <field name="empleado_id"/>
                                    <field name="horas" sum="Total Horas"/>
                                </list>
                            </field>
                        </page>
                        <page string="Añadas">
                            <field name="anada_ids">
                                <list editable="bottom">
                                    <field name="anio"/>
                                    <field name="variedad_id"/>
                                    <field name="cantidad" sum="Total kg"/>
                                    <field name="graduacion"/>
                                    <field name="sulfuroso_total" optional="show"/>
                                    <field name="ph" optional="show"/>
                                    <field name="densidad" optional="hide"/>
                                    <field name="acidez_total" optional="show"/>
                                    <field name="acidez_volatil" optional="hide"/>
                                    <field name="malico" optional="hide"/>
                                    <button name="action_open_attachments" type="object"
                                        icon="fa-paperclip"
                                        attrs="{'invisible': [('id', '=', False)]}"
                                        string="" class="btn btn-sm btn-link"
                                        help="Adjuntar analíticas PDF"/>
                                </list>
                            </field>
                        </page>
                        <page string="Aportaciones">
                            <field name="aportacion_ids">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="producto_id"/>
                                    <field name="tipo_producto" optional="show"/>
                                    <field name="cantidad" sum="Total kg"/>
                                    <field name="precio_kg" optional="show"/>
                                    <field name="coste" optional="show" readonly="1" sum="Total €"/>
                                    <field name="descripcion"/>
                                </list>
                            </field>
                        </page>
                        <page string="Plantaciones">
                            <field name="plantacion_registro_ids">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="num_plantas" sum="Total plantas"/>
                                    <field name="tipo"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <div style="display:flex;gap:16px;margin-top:16px;align-items:flex-start;">
                        <div style="flex:1 1 0;min-width:0;">
                            <h4 style="margin-bottom:6px;color:#5c5c5c;font-size:14px;font-weight:600;">
                                <i class="fa fa-map"/> Visor SIGPAC
                            </h4>
                            <widget name="sigpac_viewer"/>
                        </div>
                        <div style="flex:1 1 0;min-width:0;">
                            <h4 style="margin-bottom:6px;color:#5c5c5c;font-size:14px;font-weight:600;">
                                <i class="fa fa-list"/> Recintos SIGPAC
                            </h4>
                            <field name="recinto_ids">
                                <list>
                                    <field name="recinto_num" readonly="1"/>
                                    <field name="uso_sigpac" readonly="1"/>
                                    <field name="superficie_m2" readonly="1" sum="Total (m²)"/>
                                    <field name="variedad_resumen" readonly="1"/>
                                    <field name="activo" column_invisible="1"/>
                                    <button name="action_toggle_activo" type="object"
                                        invisible="not activo"
                                        icon="fa-toggle-on" title="Incluido — pulse para excluir"
                                        class="text-success"/>
                                    <button name="action_toggle_activo" type="object"
                                        invisible="activo"
                                        icon="fa-toggle-off" title="Excluido — pulse para incluir"
                                        class="text-muted"/>
                                </list>
                                <form string="Recinto SIGPAC">
                                    <group>
                                        <group>
                                            <field name="recinto_num" readonly="1"/>
                                            <field name="uso_sigpac" readonly="1"/>
                                            <field name="activo"/>
                                        </group>
                                        <group>
                                            <field name="superficie_ha" readonly="1"/>
                                            <field name="superficie_m2" readonly="1"/>
                                        </group>
                                    </group>
                                    <separator string="Variedades plantadas en este recinto"/>
                                    <field name="variedad_ids">
                                        <list editable="bottom">
                                            <field name="variedad_id"/>
                                            <field name="porcentaje"/>
                                            <field name="superficie_ha" readonly="1" sum="Total (ha)"/>
                                            <field name="superficie_m2" readonly="1" sum="Total (m²)"/>
                                        </list>
                                    </field>
                                    <div style="margin-top:8px;padding:8px;background:#f8f8f8;border-radius:4px;font-size:12px;color:#666;">
                                        <i class="fa fa-info-circle"/> Superficie = superficie recinto × <strong>porcentaje / 100</strong>. Los totales de la pestaña <em>Variedades</em> se actualizan al guardar.
                                    </div>
                                </form>
                            </field>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_finca" model="ir.actions.act_window">
        <field name="name">Fincas</field>
        <field name="res_model">vinedo.finca</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vinedo_root" name="Viñedo" sequence="10"
        web_icon="vinedo_field_service,static/description/icon.png"/>
    <menuitem id="menu_vinedo_fincas" name="Fincas" parent="menu_vinedo_root" action="action_finca" sequence="1"/>

    <!-- ============================================================ -->
    <!-- Variedad Views                                               -->
    <!-- ============================================================ -->
    <record id="view_variedad_tree" model="ir.ui.view">
        <field name="name">vinedo.variedad.tree</field>
        <field name="model">vinedo.variedad</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="descripcion"/>
            </list>
        </field>
    </record>

    <record id="view_variedad_form" model="ir.ui.view">
        <field name="name">vinedo.variedad.form</field>
        <field name="model">vinedo.variedad</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_variedad" model="ir.actions.act_window">
        <field name="name">Variedades</field>
        <field name="res_model">vinedo.variedad</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vinedo_variedades" name="Variedades" parent="menu_vinedo_root" action="action_variedad" sequence="2"/>

    <!-- ============================================================ -->
    <!-- Añada Views                                                  -->
    <!-- ============================================================ -->
    <record id="view_anada_tree" model="ir.ui.view">
        <field name="name">vinedo.anada.tree</field>
        <field name="model">vinedo.anada</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="anio"/>
                <field name="finca_id"/>
                <field name="variedad_id"/>
                <field name="cantidad" sum="Total kg"/>
                <field name="graduacion" avg="Graduación Media"/>
                <field name="acidez_total" avg="Acidez Total Media"/>
            </list>
        </field>
    </record>

    <record id="view_anada_form" model="ir.ui.view">
        <field name="name">vinedo.anada.form</field>
        <field name="model">vinedo.anada</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="finca_id"/>
                            <field name="variedad_disponible_ids" invisible="1"/>
                            <field name="variedad_id"
                                domain="[('id', 'in', variedad_disponible_ids)]"/>
                            <field name="anio"/>
                        </group>
                        <group>
                            <field name="graduacion"/>
                            <field name="cantidad"/>
                        </group>
                        <group string="Análisis">
                            <field name="sulfuroso_total"/>
                            <field name="ph"/>
                            <field name="densidad"/>
                            <field name="acidez_total"/>
                            <field name="acidez_volatil"/>
                            <field name="malico"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_anada_pivot" model="ir.ui.view">
        <field name="name">vinedo.anada.pivot</field>
        <field name="model">vinedo.anada</field>
        <field name="arch" type="xml">
            <pivot string="Añadas" sample="1">
                <field name="anio" type="row"/>
                <field name="finca_id" type="row"/>
                <field name="variedad_id" type="col"/>
                <field name="cantidad" type="measure"/>
                <field name="graduacion" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_anada_graph" model="ir.ui.view">
        <field name="name">vinedo.anada.graph</field>
        <field name="model">vinedo.anada</field>
        <field name="arch" type="xml">
            <graph string="Añadas" type="bar" sample="1">
                <field name="finca_id" type="row"/>
                <field name="variedad_id" type="col"/>
                <field name="cantidad" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_anada" model="ir.actions.act_window">
        <field name="name">Añadas</field>
        <field name="res_model">vinedo.anada</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <menuitem id="menu_vinedo_anadas" name="Añadas" parent="menu_vinedo_root" action="action_anada" sequence="3"/>

    <!-- ============================================================ -->
    <!-- Territorio Views (Configuración)                            -->
    <!-- ============================================================ -->
    <record id="view_territorio_tree" model="ir.ui.view">
        <field name="name">vinedo.territorio.tree</field>
        <field name="model">vinedo.territorio</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_territorio" model="ir.actions.act_window">
        <field name="name">Territorios</field>
        <field name="res_model">vinedo.territorio</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_vinedo_config" name="Configuración" parent="menu_vinedo_root" sequence="100"/>
    <menuitem id="menu_vinedo_territorios" name="Territorios" parent="menu_vinedo_config" action="action_territorio" sequence="1"/>

    <!-- ============================================================ -->
    <!-- Fitosanitario (Productos Reg. MAPA) Views                    -->
    <!-- ============================================================ -->

    <record id="view_fitosanitario_list" model="ir.ui.view">
        <field name="name">vinedo.fitosanitario.list</field>
        <field name="model">vinedo.fitosanitario</field>
        <field name="arch" type="xml">
            <list>
                <field name="num_registro"/>
                <field name="nombre"/>
                <field name="funcion"/>
                <field name="materia_activa"/>
                <field name="titular" optional="hide"/>
                <field name="formulado" optional="hide"/>
                <field name="estado"
                       decoration-success="estado == 'Vigente'"
                       decoration-muted="estado != 'Vigente'"/>
                <field name="fecha_caducidad"/>
                <field name="fecha_consulta" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fitosanitario_form" model="ir.ui.view">
        <field name="name">vinedo.fitosanitario.form</field>
        <field name="model">vinedo.fitosanitario</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_actualizar_mapa" type="object"
                        string="Actualizar desde MAPA" icon="fa-refresh"
                        class="btn-primary"
                        invisible="not id_mapa"
                        help="Recarga los datos de este producto desde el Registro de Productos Fitosanitarios del MAPA"/>
                    <button name="action_abrir_ficha_mapa" type="object"
                        string="Ver ficha en MAPA" icon="fa-external-link"
                        invisible="not num_registro"
                        help="Abre la ficha oficial en el portal del Ministerio"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="nombre" placeholder="Nombre Comercial"/></h1>
                    </div>
                    <group>
                        <group string="Registro">
                            <field name="num_registro"/>
                            <field name="id_mapa" readonly="1"/>
                            <field name="estado"
                                   decoration-success="estado == 'Vigente'"
                                   decoration-danger="estado != 'Vigente' and estado != False"/>
                            <field name="fecha_caducidad"/>
                            <field name="fecha_consulta" readonly="1"/>
                        </group>
                        <group string="Composición">
                            <field name="funcion"/>
                            <field name="materia_activa"/>
                            <field name="formulado"/>
                            <field name="titular"/>
                        </group>
                    </group>
                    <group string="Observaciones / Condiciones de Uso" invisible="not observaciones">
                        <field name="observaciones" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Import wizard -->
    <record id="view_fitosanitario_import_wizard_form" model="ir.ui.view">
        <field name="name">vinedo.fitosanitario.import.wizard.form</field>
        <field name="model">vinedo.fitosanitario.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Descargar catálogo MAPA">
                <sheet>
                    <field name="fase" invisible="1"/>
                    <group invisible="fase != 'inicio'">
                        <div colspan="2">
                            <p>Pulsa <strong>«Buscar en MAPA»</strong> para conectar con el
                               Registro Oficial de Productos Fitosanitarios y obtener el
                               catálogo completo.</p>
                            <p style="color:#6c757d;font-size:12px;">
                                El proceso puede tardar 1–3 minutos según la velocidad
                                del servidor del MAPA.
                            </p>
                        </div>
                    </group>
                    <group string="Confirmar importación" invisible="fase != 'confirmar'">
                        <field name="total_mapa" readonly="1"/>
                        <div colspan="2">
                            <p>Pulsa <strong>«Importar»</strong> para guardar los productos
                               en la base de datos local.</p>
                        </div>
                    </group>
                    <group string="Importación completada" invisible="fase != 'listo'">
                        <field name="total_creados" readonly="1"/>
                        <field name="total_actualizados" readonly="1"/>
                        <field name="total_errores" readonly="1"
                               invisible="total_errores == 0"/>
                        <div colspan="2">
                            <p>Ya puedes buscar cualquier producto desde el campo
                               <strong>«Ficha Reg. MAPA»</strong> en los tratamientos,
                               o enlazarlo automáticamente desde el campo <strong>«Producto»</strong>
                               usando la Referencia Interna = Nº de Registro.</p>
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button name="action_buscar" type="object"
                        string="Buscar en MAPA" class="btn-primary"
                        invisible="fase != 'inicio'"/>
                    <button name="action_importar" type="object"
                        string="Importar a la base de datos" class="btn-primary"
                        invisible="fase != 'confirmar'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_server_completar_funciones" model="ir.actions.server">
        <field name="name">Completar funciones desde MAPA</field>
        <field name="model_id" ref="model_vinedo_fitosanitario"/>
        <field name="binding_model_id" ref="model_vinedo_fitosanitario"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_completar_funciones()</field>
    </record>

    <record id="action_server_importar_catalogo_mapa" model="ir.actions.server">
        <field name="name">Descargar catálogo completo MAPA</field>
        <field name="model_id" ref="model_vinedo_fitosanitario"/>
        <field name="binding_model_id" ref="model_vinedo_fitosanitario"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env['vinedo.fitosanitario.import.wizard'].action_open()</field>
    </record>

    <record id="action_fitosanitario" model="ir.actions.act_window">
        <field name="name">Productos Fitosanitarios</field>
        <field name="res_model">vinedo.fitosanitario</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Catálogo vacío de productos fitosanitarios
            </p>
            <p>
                Pulsa <strong>«Descargar catálogo completo MAPA»</strong> (en cualquier ficha)
                o usa el menú <strong>Acción → Descargar catálogo completo MAPA</strong>
                para importar todos los productos del Registro MAPA a la base de datos local.
            </p>
            <p>
                Una vez importados, puedes buscarlos directamente desde el campo
                <em>«Ficha Reg. MAPA»</em> en los tratamientos, sin necesidad de
                consultar MAPA en tiempo real.
            </p>
        </field>
    </record>

    <menuitem id="menu_vinedo_fitosanitarios" name="Fitosanitarios (MAPA)"
        parent="menu_vinedo_config" action="action_fitosanitario" sequence="10"/>

    <menuitem id="menu_vinedo_descargar_catalogo" name="Descargar catálogo MAPA"
        parent="menu_vinedo_config" action="action_server_importar_catalogo_mapa" sequence="50"/>

    <!-- ============================================================ -->
    <!-- Wizard Búsqueda Fitosanitarios                               -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!-- Tratamiento standalone Views                                 -->
    <!-- ============================================================ -->

    <record id="view_tratamiento_list" model="ir.ui.view">
        <field name="name">vinedo.tratamiento.list</field>
        <field name="model">vinedo.tratamiento</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha"/>
                <field name="finca_id"/>
                <field name="tipo"/>
                <field name="producto_id" invisible="tipo != 'fitosanitario'"
                       options="{'no_quick_create': True}"/>
                <field name="producto" invisible="tipo == 'fitosanitario'"/>
                <field name="litros" optional="show"/>
                <field name="precio_litro" optional="hide"/>
                <field name="coste" optional="show" readonly="1"/>
                <field name="maquinaria_id" optional="show"/>
                <field name="materia_activa_info" optional="show" readonly="1"/>
                <field name="funcion_info" optional="show" readonly="1"/>
                <field name="estado_registro_info" optional="hide" readonly="1"/>
                <field name="fecha_caducidad_reg" optional="hide" readonly="1"/>
                <field name="dosis" optional="hide"/>
                <field name="empleado_id"/>
            </list>
        </field>
    </record>

    <record id="view_tratamiento_form" model="ir.ui.view">
        <field name="name">vinedo.tratamiento.form</field>
        <field name="model">vinedo.tratamiento</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_buscar_fitosanitario" type="object"
                        string="Consultar Registro MAPA" icon="fa-search"
                        class="btn-primary"
                        invisible="tipo != 'fitosanitario'"
                        help="Busca el producto en el Registro de Productos Fitosanitarios y rellena los datos automáticamente"/>
                    <button name="action_ver_ficha_mapa" type="object"
                        string="Ver ficha en MAPA" icon="fa-file-pdf-o"
                        invisible="not fitosanitario_id"
                        help="Abre la ficha oficial del producto en el portal del Ministerio (MAPA)"/>
                </header>
                <sheet>
                    <group>
                        <group string="Datos del tratamiento">
                            <field name="finca_id"/>
                            <field name="fecha"/>
                            <field name="tipo"/>
                            <field name="producto_id"
                                   invisible="tipo != 'fitosanitario'"
                                   options="{'no_quick_create': True}"/>
                            <field name="producto" invisible="tipo == 'fitosanitario'"/>
                            <field name="litros"/>
                            <field name="precio_litro"/>
                            <field name="coste" readonly="1"/>
                            <field name="maquinaria_id"/>
                            <field name="dosis"/>
                            <field name="empleado_id"/>
                        </group>
                        <group string="Ficha Registro MAPA"
                               invisible="tipo != 'fitosanitario'">
                            <field name="fitosanitario_id"
                                   options="{'no_quick_create': True}"
                                   domain="[('nombre', 'ilike', producto or '')]"/>
                            <field name="funcion_info" readonly="1"/>
                            <field name="materia_activa_info" readonly="1"/>
                            <field name="estado_registro_info" readonly="1"/>
                            <field name="fecha_caducidad_reg" readonly="1"/>
                        </group>
                    </group>
                    <group string="Observaciones / Condiciones de Uso"
                           invisible="not observaciones_registro">
                        <field name="observaciones_registro" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

